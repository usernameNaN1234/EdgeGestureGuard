<?xml version="1.0" encoding="utf-8"?>
<!-- 底部操作栏：白底 + 1dp 顶部分隔线 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/stroke" />
        </shape>
    </item>
</layer-list>
